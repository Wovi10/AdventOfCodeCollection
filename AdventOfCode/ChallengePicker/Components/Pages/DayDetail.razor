@page "/year/{Year:int}/day/{Day:int}"
@using AOC.Utils.Enums

<PageTitle>Advent of Code @Year - Day @FormattedDay</PageTitle>

<a href="@($"/year/{Year}")" class="back-link">&larr; Day @FormattedDay list</a>
<h1>@Year - Day @FormattedDay</h1>
<p class="text-muted">
    <a href="@($"https://adventofcode.com/{Year}/day/{Day}")" target="_blank" rel="noopener">adventofcode.com/@Year/day/@Day</a>
</p>

<div class="day-detail-section">
    <h3>Run</h3>
    <div class="form-check form-switch mb-2">
        <input class="form-check-input" type="checkbox" role="switch" id="useMockSwitch" @bind="useMockInput"/>
        <label class="form-check-label" for="useMockSwitch">Use mock input</label>
    </div>
    <div class="run-buttons">
        <button class="btn btn-outline-primary" disabled="@isRunning" @onclick="() => RunDayPart(PartsToRun.Part1)">Run Part 1</button>
        <button class="btn btn-outline-primary" disabled="@isRunning" @onclick="() => RunDayPart(PartsToRun.Part2)">Run Part 2</button>
    </div>
    @if (isRunning)
    {
        <p class="text-muted mt-2">Running...</p>
    }
    else if (runResult is not null)
    {
        @if (runResult.Success)
        {
            <p class="@savedAnswerCssClass mt-2 mb-1">Answer: @runResult.Message</p>
            <p>Saved: @savedAnswerDisplay</p>
        }
        else
        {
            <p class="text-danger mt-2">@runResult.Message</p>
        }
    }
</div>

<div class="day-detail-section">
    <h3>Answers</h3>
    <div class="answer-field">
        <label>Part 1 - Mock</label>
        <div class="answer-input-row">
            <input class="form-control form-control-sm" @bind="answers.Part1Mock"/>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => answers.Part1Mock = AnswerStore.NotYetFound">Not Yet Found</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => answers.Part1Mock = AnswerStore.NotApplicable">N/A</button>
        </div>
    </div>
    <div class="answer-field">
        <label>Part 1 - Real</label>
        <div class="answer-input-row">
            <input class="form-control form-control-sm" @bind="answers.Part1Real"/>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => answers.Part1Real = AnswerStore.NotYetFound">Not Yet Found</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => answers.Part1Real = AnswerStore.NotApplicable">N/A</button>
        </div>
    </div>
    <div class="answer-field">
        <label>Part 2 - Mock</label>
        <div class="answer-input-row">
            <input class="form-control form-control-sm" @bind="answers.Part2Mock"/>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => answers.Part2Mock = AnswerStore.NotYetFound">Not Yet Found</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => answers.Part2Mock = AnswerStore.NotApplicable">N/A</button>
        </div>
    </div>
    <div class="answer-field">
        <label>Part 2 - Real</label>
        <div class="answer-input-row">
            <input class="form-control form-control-sm" @bind="answers.Part2Real"/>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => answers.Part2Real = AnswerStore.NotYetFound">Not Yet Found</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => answers.Part2Real = AnswerStore.NotApplicable">N/A</button>
        </div>
    </div>
    <button class="btn btn-primary mt-2" @onclick="SaveAnswers">Save Answers</button>
</div>

<div class="day-detail-section">
    <h3>Description</h3>
    @if (editingDescription || string.IsNullOrEmpty(description))
    {
        <textarea class="form-control" rows="8" @bind="description"></textarea>
        <button class="btn btn-primary mt-2" @onclick="SaveDescription">Save Description</button>
    }
    else
    {
        <div class="markdown-body">@((MarkupString)Markdig.Markdown.ToHtml(description))</div>
        <button class="btn btn-secondary btn-sm" @onclick="() => editingDescription = true">Edit</button>
    }
</div>

<div class="day-detail-section">
    <h3>Real Input</h3>
    @if (editingRealInput || !realInputExists)
    {
        <textarea class="form-control" rows="10" @bind="realInput"></textarea>
        <button class="btn btn-primary mt-2" @onclick="SaveRealInput">Save Real Input</button>
    }
    else
    {
        <p>@realInputFileName</p>
        <button class="btn btn-secondary btn-sm" @onclick="() => editingRealInput = true">Edit</button>
    }
</div>

<div class="day-detail-section">
    <h3>Mock Input</h3>
    @if (editingMockInput || !mockInputExists)
    {
        <textarea class="form-control" rows="10" @bind="mockInput"></textarea>
        <button class="btn btn-primary mt-2" @onclick="SaveMockInput">Save Mock Input</button>
    }
    else
    {
        <p>@mockInputFileName</p>
        <button class="btn btn-secondary btn-sm" @onclick="() => editingMockInput = true">Edit</button>
    }
</div>

@if (savedMessage is not null)
{
    <p class="text-success">@savedMessage</p>
}

@code {
    [Parameter] public int Year { get; set; }
    [Parameter] public int Day { get; set; }

    private string FormattedDay => Day.ToString().PadLeft(2, '0');

    private string description = string.Empty;
    private bool editingDescription;

    private string realInput = string.Empty;
    private bool editingRealInput;
    private bool realInputExists;
    private string realInputFileName = string.Empty;

    private string mockInput = string.Empty;
    private bool editingMockInput;
    private bool mockInputExists;
    private string mockInputFileName = string.Empty;

    private DayAnswers answers = new();

    private string? savedMessage;

    private bool isRunning;
    private bool useMockInput;
    private ChallengeRunResult? runResult;
    private PartsToRun? lastRunPart;
    private string savedAnswerDisplay = string.Empty;
    private string savedAnswerCssClass = "text-body";

    protected override void OnParametersSet()
    {
        description = DescriptionStore.Get(Year, Day);
        editingDescription = false;

        realInput = ChallengeManager.GetRealInput(Year, Day);
        realInputExists = ChallengeManager.RealInputExists(Year, Day);
        realInputFileName = ChallengeManager.GetRealInputFileName(Year, Day);
        editingRealInput = false;

        mockInput = ChallengeManager.GetMockInput(Year, Day);
        mockInputExists = ChallengeManager.MockInputExists(Year, Day);
        mockInputFileName = ChallengeManager.GetMockInputFileName(Year, Day);
        editingMockInput = false;

        answers = AnswerStore.Get(Year, Day);

        savedMessage = null;
        runResult = null;
        lastRunPart = null;
        useMockInput = false;
    }

    private async Task RunDayPart(PartsToRun part)
    {
        isRunning = true;
        runResult = null;
        StateHasChanged();

        runResult = await ChallengeManager.RunPart(Year, Day, part, useMockInput);
        lastRunPart = part;
        isRunning = false;

        if (runResult.Success)
            UpdateSavedAnswerDisplay();
    }

    private void UpdateSavedAnswerDisplay()
    {
        if (lastRunPart is null || runResult is null)
            return;

        var saved = GetSavedAnswer(lastRunPart.Value);
        savedAnswerDisplay = string.IsNullOrEmpty(saved) ? "(not set)" : saved;

        savedAnswerCssClass = saved switch
        {
            "" => "text-body",
            AnswerStore.NotYetFound => "text-body",
            AnswerStore.NotApplicable => "text-danger",
            _ => saved == runResult.Message ? "text-success" : "text-danger"
        };
    }

    private string GetSavedAnswer(PartsToRun part) => (part, useMockInput) switch
    {
        (PartsToRun.Part1, true) => answers.Part1Mock,
        (PartsToRun.Part1, false) => answers.Part1Real,
        (PartsToRun.Part2, true) => answers.Part2Mock,
        (PartsToRun.Part2, false) => answers.Part2Real,
        _ => string.Empty
    };

    private void SaveDescription()
    {
        DescriptionStore.Save(Year, Day, description);
        editingDescription = false;
        savedMessage = "Description saved.";
    }

    private void SaveRealInput()
    {
        ChallengeManager.SaveRealInput(Year, Day, realInput);
        realInputExists = true;
        editingRealInput = false;
        savedMessage = "Real input saved.";
    }

    private void SaveMockInput()
    {
        ChallengeManager.SaveMockInput(Year, Day, mockInput);
        mockInputExists = true;
        editingMockInput = false;
        savedMessage = "Mock input saved.";
    }

    private void SaveAnswers()
    {
        AnswerStore.Save(Year, Day, answers);
        savedMessage = "Answers saved.";

        if (runResult is { Success: true })
            UpdateSavedAnswerDisplay();
    }
}
