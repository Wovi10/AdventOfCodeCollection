@page "/year/{Year:int}"

<PageTitle>Advent of Code @Year</PageTitle>

<a href="/" class="back-link">&larr; Years</a>
<h1>@Year</h1>
<p class="text-muted">
    Pick a day, or add a new one.
    <a href="@($"https://adventofcode.com/{Year}")" target="_blank" rel="noopener">adventofcode.com/@Year</a>
</p>

<div class="day-grid">
    @foreach (var day in ExistingDays)
    {
        var hasAnswers = HasAnswers(day);
        var hasAllAnswers = hasAnswers && HasAllAnswers(day);
        var label = day.ToString().PadLeft(2, '0');
        var cssClass = hasAnswers
            ? hasAllAnswers
                ? "day-tile-solved"
                : "day-tile-partial"
            : "day-tile-missing";
        <a class="day-tile @cssClass" href="@($"year/{Year}/day/{day}")">Day @label</a>
    }
</div>

@if (isAddingDay)
{
    <div class="add-day-form">
        <input type="number" min="1" max="25" class="form-control form-control-sm" placeholder="Day number"
               @bind="newDay"/>
        <input type="text" class="form-control form-control-sm" placeholder="Title (optional)"
               @bind="newDayTitle"/>
        <button class="btn btn-sm btn-success" @onclick="ConfirmAddDay">Add</button>
        <button class="btn btn-sm btn-secondary" @onclick="CancelAddDay">Cancel</button>
    </div>
}
else
{
    <button class="btn btn-primary" @onclick="StartAddDay">+ New Day</button>
}

@if (errorMessage is not null)
{
    <p class="text-danger">@errorMessage</p>
}

@code {
    [Parameter] public int Year { get; set; }

    private static readonly List<int> AllDays = Enumerable.Range(1, 25).ToList();

    private List<int> ExistingDays { get; set; } = [];

    private bool isAddingDay;
    private int? newDay;
    private string? newDayTitle;
    private string? errorMessage;

    protected override void OnParametersSet()
    {
        ExistingDays = ChallengeManager.GetExistingDays(Year).ToList();
    }

    private void StartAddDay()
    {
        isAddingDay = true;
        newDay = ExistingDays.Count > 0 ? ExistingDays.Max() + 1 : 1;
        newDayTitle = null;
        errorMessage = null;
    }

    private void CancelAddDay()
    {
        isAddingDay = false;
        newDay = null;
        newDayTitle = null;
    }

    private void ConfirmAddDay()
    {
        if (newDay is not (>= 1 and <= 25))
        {
            errorMessage = "Day must be between 1 and 25.";
            return;
        }

        if (ExistingDays.Contains(newDay.Value))
        {
            errorMessage = $"Day {newDay:D2} already exists.";
            return;
        }

        if (ChallengeManager.IsLegacyYear(Year))
        {
            errorMessage = $"{Year} is a legacy project - add the day's .cs file there directly.";
            return;
        }

        ChallengeManager.CreateDay(Year, newDay.Value, newDayTitle);
        ExistingDays = ChallengeManager.GetExistingDays(Year).ToList();

        CancelAddDay();
    }

    private bool HasAnswers(int day)
    {
        return AnswerStore.HasAnswers(Year, day);
    }

    private bool HasAllAnswers(int day)
    {
        return AnswerStore.HasAllAnswers(Year, day);
    }

}
